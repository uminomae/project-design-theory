{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -r /)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(chmod 777 *)",
      "Read(~/dev-private/**)",
      "Edit(~/dev-private/**)",
      "Write(~/dev-private/**)",
      "Bash(*dev-private*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git-merge.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/content-compile.sh",
            "timeout": 20,
            "statusMessage": "Content wiki-link compile..."
          }
        ]
      }
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "git push",
      "git push *",
      "git fetch",
      "git fetch *",
      "git pull",
      "git pull *",
      "git ls-remote",
      "git ls-remote *",
      "git -C * push",
      "git -C * push *",
      "git -C * fetch *",
      "git -C * pull *",
      "git merge --ff-only develop",
      "git -C * merge --ff-only develop",
      "git merge --ff-only *",
      "git -C * merge --ff-only *",
      "gh",
      "gh *"
    ]
  }
}
